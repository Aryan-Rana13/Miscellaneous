#include <iostream>
using namespace std;

/* -------pattern 1-------
+
++
+++
++++
+++++
*/
void pattern1(int n)
{

    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= i; j++)
        {
            cout << "+";
        }
        cout << "\n";
    }
}

/*-------pattern 2-------
*****
****
***
**
*
*/
void pattern2(int n)
{
    for (int i = 1; i <= n; i++)
    {
        for (int j = n; j >= i; j--)
        {
            cout << "+";
        }
        cout << "\n";
    }
}

/*-------pattern 3-------
