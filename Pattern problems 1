  +++
 ++++
+++++
*/
void pattern3(int n)
{
    for (int i = 1; i <= n; i++)
    {
        for (int j = n; j > i; j--)
        {
            cout << " ";
        }
        for (int k = 1; k <= i; k++)
        {
            cout << "+";
        }
        cout << "\n";
    }
}
